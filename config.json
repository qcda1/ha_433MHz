{
  "name": "RTL-433 Sensor Bridge",
  "version": "1.1.0",
  "slug": "rtl433_bridge",
  "description": "Reads 433MHz sensor data from pbkhrv/rtl_433 add-on output and pushes to Home Assistant.",
  "url": "https://github.com/qcda1/ha_433MHz",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "startup": "application",
  "boot": "auto",
  "map": ["config:rw"],
  "full_access": true,
  "options": {
    "scan_interval": 60,
    "ha_url": "http://homeassistant:8123",
    "ha_token": ""
  },
  "schema": {
    "scan_interval": "int(10,3600)",
    "ha_url": "str",
    "ha_token": "str"
  },
  "panel_icon": "mdi:thermometer-wireless",
  "panel_title": "RTL-433 Sensors",
  "ingress": true,
  "ingress_port": 8099,
  "homeassistant_api": true,
  "hassio_api": true
}
