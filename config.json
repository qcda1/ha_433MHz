{
  "name": "RTL-433 Sensor Bridge",
  "version": "1.0.0",
  "slug": "rtl433_bridge",
  "description": "Reads 433MHz temperature/humidity sensors via RTL-SDR and pushes them to Home Assistant.",
  "url": "https://github.com/qcda1/ha_433MHz",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "startup": "application",
  "boot": "auto",
  "map": ["config:rw"],
  "options": {
    "scan_interval": 300,
    "scan_duration": 90,
    "frequency": 433920000,
    "ha_url": "http://homeassistant:8123",
    "ha_token": ""
  },
  "schema": {
    "scan_interval": "int(60,3600)",
    "scan_duration": "int(30,300)",
    "frequency": "int(300000000,1700000000)",
    "ha_url": "str",
    "ha_token": "str"
  },
  "panel_icon": "mdi:thermometer-wireless",
  "panel_title": "RTL-433 Sensors",
  "ingress": true,
  "ingress_port": 8099,
  "homeassistant_api": true,
  "hassio_api": true
}
